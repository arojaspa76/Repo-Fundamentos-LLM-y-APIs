# Copie como .env dentro de esta carpeta:  cp .env.example .env

# --- Opción A: Google Cloud (Agent Platform). Recomendada para el despliegue. ---
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=su-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1

# --- Opción B: solo pruebas locales con una API key de Google AI Studio ---
# GOOGLE_GENAI_USE_ENTERPRISE=0
# GOOGLE_API_KEY=su-api-key

MODEL=gemini-3.5-flash

# Nota: versiones anteriores de los SDK usaban GOOGLE_GENAI_USE_VERTEXAI=TRUE.
# Sigue funcionando, pero la variable nueva es GOOGLE_GENAI_USE_ENTERPRISE.

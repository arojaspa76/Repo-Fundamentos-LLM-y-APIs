# Copie este archivo como .env y ajuste los valores:  cp .env.example .env

# ---- Local (obligatorio para la clase) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Google Gemini (opcional) ----
# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# ---- Cualquier API compatible con OpenAI (opcional) ----
# Ejemplos:
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1   (sí, Ollama también habla "OpenAI")
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_DEFAULT_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
